{
  "name": "wordwall-discord-activity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free, unpaywalled Wordwall-style party & classroom games (Spin the Wheel, Open the Box, Random Cards) built as a Discord Activity.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
